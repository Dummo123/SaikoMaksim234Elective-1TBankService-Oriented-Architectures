{
  "uid": "warehouse-infra",
  "title": "Warehouse — Infrastructure",
  "tags": ["warehouse", "infrastructure"],
  "timezone": "browser",
  "refresh": "15s",
  "schemaVersion": 38,
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "gridPos": {"x":0,"y":0,"w":12,"h":8},
      "title": "Kafka — Consumer Lag (all partitions)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "consumer_lag", "legendFormat": "partition {{partition}}" },
        { "expr": "sum(consumer_lag)", "legendFormat": "TOTAL" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":500},{"color":"red","value":1000}] }
        }
      }
    },
    {
      "id": 2, "type": "timeseries", "gridPos": {"x":12,"y":0,"w":12,"h":8},
      "title": "Kafka — Events Produced to Topic (rate)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(wms_events_produced_total[1m])) by (event_type, version)", "legendFormat": "{{event_type}} ({{version}})" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3, "type": "timeseries", "gridPos": {"x":0,"y":8,"w":12,"h":8},
      "title": "Kafka — Broker Count",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "kafka_brokers", "legendFormat": "brokers" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"green","value":1}] }
        }
      }
    },
    {
      "id": 4, "type": "timeseries", "gridPos": {"x":12,"y":8,"w":12,"h":8},
      "title": "Kafka — Topic Partition Offsets",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "kafka_topic_partition_current_offset{topic=\"warehouse-events\"}", "legendFormat": "partition {{partition}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5, "type": "timeseries", "gridPos": {"x":0,"y":16,"w":12,"h":8},
      "title": "Cassandra — Read Latency (ms)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "cassandra_read_latency_ms", "legendFormat": "read ping ms" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":10},{"color":"red","value":50}] }
        }
      }
    },
    {
      "id": 6, "type": "timeseries", "gridPos": {"x":12,"y":16,"w":12,"h":8},
      "title": "Cassandra — Inventory Records Total",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "cassandra_inventory_records_total", "legendFormat": "inventory_by_product_zone rows" },
        { "expr": "cassandra_processed_events_stored", "legendFormat": "processed_events rows (TTL)" },
        { "expr": "cassandra_orders_total", "legendFormat": "orders rows" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7, "type": "stat", "gridPos": {"x":0,"y":24,"w":6,"h":4},
      "title": "Cassandra — Cluster Up",
      "datasource": "Prometheus",
      "targets": [{ "expr": "cassandra_up", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}],
          "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"green","value":1}] }
        }
      }
    },
    {
      "id": 8, "type": "stat", "gridPos": {"x":6,"y":24,"w":6,"h":4},
      "title": "Cassandra — Visible Nodes",
      "datasource": "Prometheus",
      "targets": [{ "expr": "cassandra_cluster_nodes_total", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":1},{"color":"green","value":3}] }
        }
      }
    },
    {
      "id": 9, "type": "timeseries", "gridPos": {"x":12,"y":24,"w":12,"h":8},
      "title": "Cassandra — Write Errors (rate)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(cassandra_write_errors_total[2m])", "legendFormat": "write errors/s" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":0.01}] }
        }
      }
    }
  ]
}
